{
  "name": "dsh-plugin-artifacts",
  "version": "2.0.1",
  "type": "module",
  "description": "我的产物：DSH 侧栏一级入口 + 独立页面。按「产物 / 过程 / 记忆 / 素材」分层整理工作区文件，多工作区、12 类文件类型、按年/月/日分组的时间轴、预览与重命名、回收站与归档，可选的多工作区 COS 手动上传与定时同步。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmengle/dsh-plugin-artifacts.git"
  },
  "homepage": "https://github.com/zmengle/dsh-plugin-artifacts#readme",
  "bugs": {
    "url": "https://github.com/zmengle/dsh-plugin-artifacts/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs",
    "verify": "node test/verify-package.mjs",
    "prepublishOnly": "npm run verify && npm test"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=2.0.0-0 <3.0.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "artifacts",
    "deliverables",
    "file-manager",
    "artifact-manager",
    "cos",
    "我的产物"
  ],
  "license": "MIT"
}
